{
  "Rules": [
    {
      "Id": "HARDWARE-A001",
      "Severity": "error",
      "Description": "Hardware projects must not reference Machine application projects.",
      "Include": [
        "DeviceFunction/**/*.csproj",
        "DeviceUI/**/*.csproj"
      ],
      "Exclude": [],
      "Forbidden": [
        "BurnInTester.csproj",
        "RGBTester.csproj",
        "ProbeTester.csproj",
        "LFSMEO.csproj",
        "<Reference Include=\"BurnInTester",
        "<Reference Include=\"RGBTester",
        "<Reference Include=\"ProbeTester",
        "<Reference Include=\"LFSMEO",
        "BurnInTester.dll",
        "RGBTester.dll",
        "ProbeTester.dll",
        "LFSMEO.dll"
      ]
    },
    {
      "Id": "INSTRUMENT-A001",
      "Severity": "error",
      "Description": "Instrument driver projects must only wrap vendor APIs or communication details and must not reference LFSMEO platform projects.",
      "Include": [
        "Device_APS/**/*.csproj",
        "Device_Hikvision/**/*.csproj",
        "Device_Klzx/**/*.csproj",
        "Device_MicroEpsilon/**/*.csproj",
        "Device_MN200/**/*.csproj",
        "Device_OTO/**/*.csproj",
        "Device_PCIS_DASK/**/*.csproj",
        "Device_Spectrum_Virtual/**/*.csproj",
        "Device_TemeratureControl_Virtual/**/*.csproj",
        "Device_Virtual/**/*.csproj",
        "Device_VirtualCamera/**/*.csproj",
        "FTLight/**/*.csproj",
        "Guishan/**/*.csproj",
        "VirtualLight/**/*.csproj"
      ],
      "Exclude": [],
      "Forbidden": [
        "ArchitectureChecker.csproj",
        "BurnInTester.csproj",
        "DeviceFunction.csproj",
        "DeviceUI.csproj",
        "FormTest.csproj",
        "FunctionUnitTest.csproj",
        "LFSMEO.csproj",
        "MachineCore.csproj",
        "ProbeTester.csproj",
        "RecipeManage.csproj",
        "RGBTester.csproj",
        "SampleCode.csproj",
        "SampleMachine.csproj",
        "ToolFunction.csproj",
        "UserPrivilege.csproj",
        "<Reference Include=\"ArchitectureChecker",
        "<Reference Include=\"BurnInTester",
        "<Reference Include=\"DeviceCore",
        "<Reference Include=\"DeviceFunction",
        "<Reference Include=\"DeviceUI",
        "<Reference Include=\"FormTest",
        "<Reference Include=\"FunctionUnitTest",
        "<Reference Include=\"LFSMEO",
        "<Reference Include=\"MachineCore",
        "<Reference Include=\"ProbeTester",
        "<Reference Include=\"RecipeManage",
        "<Reference Include=\"RGBTester",
        "<Reference Include=\"SampleCode",
        "<Reference Include=\"SampleMachine",
        "<Reference Include=\"ToolFunction",
        "<Reference Include=\"UserPrivilege",
        "ArchitectureChecker.dll",
        "BurnInTester.dll",
        "DeviceCore.dll",
        "DeviceFunction.dll",
        "DeviceUI.dll",
        "FormTest.dll",
        "FunctionUnitTest.dll",
        "LFSMEO.dll",
        "MachineCore.dll",
        "ProbeTester.dll",
        "RecipeManage.dll",
        "RGBTester.dll",
        "SampleCode.dll",
        "SampleMachine.dll",
        "ToolFunction.dll",
        "UserPrivilege.dll"
      ]
    },
    {
      "Id": "HARDWARE-A002",
      "Severity": "warning",
      "Description": "Hardware source should not use Machine application namespaces directly.",
      "Include": [
        "DeviceFunction/**/*.cs",
        "DeviceUI/**/*.cs"
      ],
      "Exclude": [],
      "Forbidden": [
        "using BurnInTester",
        "using RGBTester",
        "using ProbeTester",
        "using LFSMEO",
        "BurnInTester.",
        "RGBTester.",
        "ProbeTester.",
        "LFSMEO."
      ]
    }
  ]
}
